<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>security_robot_alerts</name>
  <version>0.0.1</version>
  <description>Alerts backend and web dashboard for the security robot</description>
  <maintainer email="slim@todo.todo">slim</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>security_robot_perception</exec_depend>
  <exec_depend>security_robot_security</exec_depend>
  <exec_depend>security_robot_webots</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
