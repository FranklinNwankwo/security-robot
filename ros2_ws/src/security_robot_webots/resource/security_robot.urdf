<?xml version="1.0" ?>
<robot name="security_robot">
    <webots>
        <device reference="lidar" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <topicName>/scan_raw</topicName>
                <updateRate>10</updateRate>
                <alwaysOn>true</alwaysOn>
                <frameName>lidar_link</frameName>
            </ros>
        </device>

        <device reference="camera" type="Camera">
            <ros>
                <topicName>/camera</topicName>
                <updateRate>10</updateRate>
                <alwaysOn>false</alwaysOn>
                <frameName>camera_optical_link</frameName>
            </ros>
        </device>

        <plugin type="webots_ros2_driver::Ros2IMU">
            <enabled>true</enabled>
            <topicName>/imu/raw</topicName>
            <alwaysOn>true</alwaysOn>
            <frameName>imu_link</frameName>
            <inertialUnitName>imu</inertialUnitName>
            <gyroName>gyro</gyroName>
            <accelerometerName>accelerometer</accelerometerName>
        </plugin>

        <plugin type="security_robot_webots.security_robot_driver.SecurityRobotDriver">
            <odomTopic>/odom</odomTopic>
            <publishTf>true</publishTf>
        </plugin>
    </webots>
</robot>
